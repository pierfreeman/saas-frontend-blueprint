{
  "name": "@saas-frontend/source",
  "version": "0.1.0",
  "description": "Source code for the SaaS frontend application",
  "author": "Piercarlo Serena <piercarlo.serena@gmail.com>",
  "repository": "https://github.com/pierfreeman/saas-frontend-blueprint",
  "bugs": "https://github.com/pierfreeman/saas-frontend-blueprint/issues",
  "license": "UNLICENSED",
  "scripts": {
    "build": "nx run-many --target=build --projects=shell,auth,platform,admin --parallel=1",
    "build:all": "nx run-many --target=build --all --parallel=1",
    "build:shell": "nx build shell",
    "serve": "nx serve shell --devRemotes=auth,platform,admin",
    "serve:shell": "nx serve shell",
    "lint": "nx run-many --target=lint --all",
    "test": "nx run-many --target=test --all",
    "test:unit": "nx run-many --target=test --all --parallel=3",
    "test:coverage": "nx run-many --target=test --all --coverage --parallel=3",
    "test:watch": "nx test shell --watch",
    "test:affected": "nx affected -t test",
    "typecheck": "nx run-many --target=typecheck --all",
    "graph": "nx graph",
    "coverage:serve": "python3 -m http.server 4321 --directory coverage"
  },
  "private": true,
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.3.1",
    "@angular/build": "~21.2.3",
    "@angular-devkit/build-angular": "~21.2.3",
    "@angular-devkit/core": "~21.2.3",
    "@angular-devkit/schematics": "~21.2.3",
    "@angular/cli": "~21.2.3",
    "@angular/compiler-cli": "~21.2.5",
    "@angular/language-service": "~21.2.5",
    "@eslint/js": "^9.8.0",
    "@nx/eslint": "22.6.1",
    "@nx/eslint-plugin": "22.6.1",
    "@nx/js": "22.6.1",
    "@nx/module-federation": "22.6.1",
    "@nx/web": "22.6.1",
    "@nx/webpack": "22.6.1",
    "@oxc-project/runtime": "^0.122.0",
    "@schematics/angular": "~21.2.4",
    "@swc-node/register": "1.11.1",
    "@swc/core": "1.15.18",
    "@swc/helpers": "0.5.19",
    "@tailwindcss/postcss": "^4.2.2",
    "@typescript-eslint/utils": "^8.57.2",
    "@vitest/ui": "^4.1.2",
    "angular-eslint": "^21.3.1",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^10.1.8",
    "nx": "22.6.1",
    "prettier": "~3.8.1",
    "tslib": "^2.8.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.2"
  },
  "workspaces": [
    "packages/*"
  ],
  "dependencies": {
    "@angular/animations": "^21.2.5",
    "@angular/common": "~21.2.5",
    "@angular/compiler": "~21.2.5",
    "@angular/core": "~21.2.5",
    "@angular/forms": "~21.2.5",
    "@angular/platform-browser": "~21.2.5",
    "@angular/router": "~21.2.5",
    "@auth0/auth0-angular": "^2.7.0",
    "@nx/angular": "^22.6.1",
    "@primeuix/themes": "^2.0.3",
    "@vitest/coverage-v8": "^4.1.2",
    "jsdom": "^29.0.1",
    "primeicons": "^7.0.0",
    "primeng": "^21.1.3",
    "rxjs": "~7.8.2",
    "socket.io-client": "^4.8.3",
    "tailwindcss": "^4.2.2",
    "tailwindcss-primeui": "^0.6.1",
    "vitest": "^4.1.2",
    "zone.js": "^0.16.1"
  }
}
