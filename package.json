{
  "name": "@saas-frontend/source",
  "version": "0.7.0",
  "description": "Source code for the SaaS frontend application",
  "author": "Piercarlo Serena <piercarlo.serena@gmail.com>",
  "repository": "https://github.com/pierfreeman/saas-frontend-blueprint",
  "bugs": "https://github.com/pierfreeman/saas-frontend-blueprint/issues",
  "license": "UNLICENSED",
  "scripts": {
    "build": "nx run-many --target=build --projects=shell,auth,platform,admin --parallel=1",
    "build:all": "nx run-many --target=build --all --parallel=1",
    "build:shell": "nx build shell",
    "serve": "nx serve shell --devRemotes=auth,platform",
    "serve:shell": "nx serve shell",
    "serve:admin": "nx serve admin",
    "serve:all": "nx run-many -t serve -p shell admin --parallel=2",
    "lint": "nx run-many --target=lint --all",
    "test": "nx run-many --target=test --all",
    "test:unit": "nx run-many --target=test --all --parallel=3",
    "test:coverage": "nx run-many --target=test --all --coverage --parallel=3",
    "test:watch": "nx test shell --watch",
    "test:affected": "nx affected -t test",
    "typecheck": "nx run-many --target=typecheck --all",
    "graph": "nx graph",
    "coverage:serve": "python3 -m http.server 4321 --directory coverage"
  },
  "private": true,
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.5.0",
    "@angular-devkit/build-angular": "~21.2.9",
    "@angular-devkit/core": "~21.2.9",
    "@angular-devkit/schematics": "~21.2.9",
    "@angular/build": "~21.2.9",
    "@angular/cli": "~21.2.9",
    "@angular/compiler-cli": "~21.2.11",
    "@angular/language-service": "~21.2.11",
    "@eslint/js": "^10.0.1",
    "@module-federation/enhanced": "^2.6.0",
    "@nx/angular": "^23.0.1",
    "@nx/eslint": "23.0.1",
    "@nx/eslint-plugin": "23.0.1",
    "@nx/js": "23.0.1",
    "@nx/module-federation": "23.0.1",
    "@nx/web": "23.0.1",
    "@nx/webpack": "23.0.1",
    "@oxc-project/runtime": "^0.137.0",
    "@schematics/angular": "~21.2.11",
    "@swc-node/register": "1.11.1",
    "@swc/core": "1.15.43",
    "@swc/helpers": "0.5.23",
    "@tailwindcss/postcss": "^4.3.1",
    "@typescript-eslint/utils": "^8.62.0",
    "@vitest/coverage-v8": "^4.1.9",
    "@vitest/ui": "^4.1.9",
    "angular-eslint": "^21.0.0",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^29.1.1",
    "nx": "23.0.1",
    "prettier": "~3.8.5",
    "tailwindcss": "^4.3.1",
    "tailwindcss-primeui": "^0.6.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.62.0",
    "vitest": "^4.1.9"
  },
  "workspaces": [
    "packages/*"
  ],
  "dependencies": {
    "@angular/animations": "~21.2.11",
    "@angular/common": "~21.2.11",
    "@angular/compiler": "~21.2.11",
    "@angular/core": "~21.2.11",
    "@angular/forms": "~21.2.11",
    "@angular/platform-browser": "~21.2.11",
    "@angular/router": "~21.2.11",
    "@auth0/auth0-angular": "^2.9.0",
    "@fullcalendar/angular": "^6.1.21",
    "@fullcalendar/core": "^6.1.21",
    "@fullcalendar/daygrid": "^6.1.21",
    "@fullcalendar/interaction": "^6.1.21",
    "@fullcalendar/timegrid": "^6.1.21",
    "@primeuix/themes": "^2.0.3",
    "primeicons": "^7.0.0",
    "primeng": "^21.1.9",
    "rrule": "^2.8.1",
    "rxjs": "~7.8.2",
    "socket.io-client": "^4.8.3",
    "zone.js": "^0.16.2",
    "tslib": "^2.8.1"
  }
}
