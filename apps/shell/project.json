{
  "name": "shell",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "app",
  "sourceRoot": "apps/shell/src",
  "tags": ["type:app", "scope:shell"],
  "targets": {
    "build": {
      "executor": "@nx/angular:webpack-browser",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/apps/shell",
        "index": "apps/shell/src/index.html",
        "main": "apps/shell/src/main.ts",
        "tsConfig": "apps/shell/tsconfig.app.json",
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/shell/public"
          }
        ],
        "styles": [
          "node_modules/primeicons/primeicons.css",
          "apps/shell/src/styles.css"
        ],
        "customWebpackConfig": {
          "path": "apps/shell/webpack.config.ts"
        },
        "allowedCommonJsDependencies": ["debug"]
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "500kb",
              "maximumError": "1mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "4kb",
              "maximumError": "8kb"
            }
          ],
          "outputHashing": "all",
          "customWebpackConfig": {
            "path": "apps/shell/webpack.prod.config.ts"
          }
        },
        "development": {
          "buildOptimizer": false,
          "optimization": false,
          "vendorChunk": true,
          "extractLicenses": false,
          "sourceMap": true,
          "namedChunks": true
        }
      },
      "defaultConfiguration": "production"
    },
    "serve": {
      "continuous": true,
      "executor": "@nx/angular:module-federation-dev-server",
      "options": {
        "port": 4200,
        "publicHost": "http://localhost:4200",
        "devRemotes": [
          { "remoteName": "auth", "configuration": "development" },
          { "remoteName": "platform", "configuration": "development" },
          { "remoteName": "admin", "configuration": "development" }
        ]
      },
      "configurations": {
        "production": {
          "buildTarget": "shell:build:production"
        },
        "development": {
          "buildTarget": "shell:build:development"
        }
      },
      "defaultConfiguration": "development"
    },
    "extract-i18n": {
      "executor": "@angular-devkit/build-angular:extract-i18n",
      "options": {
        "buildTarget": "shell:build"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "build-for-test": {
      "executor": "@nx/angular:application",
      "options": {
        "outputPath": "dist/apps/shell-test",
        "tsConfig": "apps/shell/tsconfig.app.json"
      }
    },
    "test": {
      "executor": "@nx/angular:unit-test",
      "options": {
        "buildTarget": "shell:build-for-test",
        "tsConfig": "apps/shell/tsconfig.spec.json",
        "runnerConfig": "apps/shell/vitest.config.ts",
        "watch": false,
        "coverageInclude": ["apps/shell/src/**/*.ts"],
        "coverageExclude": [
          "apps/shell/src/**/*.spec.ts",
          "apps/shell/src/main.ts",
          "apps/shell/src/environments/**"
        ],
        "coverageReporters": ["text", "lcov", "html"]
      }
    },
    "serve-static": {
      "continuous": true,
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "shell:build",
        "port": 4200,
        "spa": true
      }
    }
  }
}
