# =============================================================================
# Vercel Deployment — Environment Variables Reference
# =============================================================================
# Set these in each Vercel project's Environment Variables settings.
# Never commit real credentials. This file is documentation only.
# =============================================================================

# ---------------------------------------------------------------------------
# ALL PROJECTS (shell, auth, platform, admin)
# ---------------------------------------------------------------------------

# Identifies which app this Vercel project builds.
# Must match the Nx project name exactly.
VERCEL_APP=shell

# Backend API base URL (no trailing slash).
API_BASE_URL=https://api.yourdomain.com

# ---------------------------------------------------------------------------
# SHELL PROJECT ONLY
# ---------------------------------------------------------------------------

# Auth0 application settings (get from Auth0 Dashboard → Applications).
AUTH0_DOMAIN=your-tenant.eu.auth0.com
AUTH0_CLIENT_ID=your_auth0_client_id
AUTH0_AUDIENCE=https://api.yourdomain.com
AUTH0_REDIRECT_URI=https://app.yourdomain.com/auth/callback

# Remote microfrontend base URLs (no trailing slash, no /remoteEntry.js).
# Each remote's Vercel project URL. Injected into remotes.json at build time.
REMOTE_AUTH_URL=https://auth.yourdomain.com
REMOTE_PLATFORM_URL=https://platform.yourdomain.com
REMOTE_ADMIN_URL=https://admin.yourdomain.com

# ---------------------------------------------------------------------------
# PLATFORM PROJECT ONLY
# ---------------------------------------------------------------------------

# Stripe Price ID for the Pro plan (Stripe Dashboard → Products → Price ID).
STRIPE_PRICE_ID=price_xxxxxxxxxxxxxxxxxxxxxxxx

# ---------------------------------------------------------------------------
# STAGING OVERRIDES (set per-environment in Vercel Dashboard)
# Use the same variable names — Vercel's "Environment" selector applies them
# to Production, Preview (staging branch), or all Preview branches.
#
# Example staging values:
#   API_BASE_URL=https://staging-api.yourdomain.com
#   AUTH0_REDIRECT_URI=https://staging-app.yourdomain.com/auth/callback
#   REMOTE_AUTH_URL=https://staging-auth.yourdomain.com
#   REMOTE_PLATFORM_URL=https://staging-platform.yourdomain.com
#   REMOTE_ADMIN_URL=https://staging-admin.yourdomain.com
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# AUTO-INJECTED BY VERCEL (do not set manually)
# Used by scripts/vercel-ignore.sh for Nx affected detection.
# ---------------------------------------------------------------------------
VERCEL_GIT_COMMIT_SHA=
VERCEL_GIT_PREVIOUS_SHA=
