{
  "compilerOptions": {
    "baseUrl": ".",
    "target": "es2022",
    "lib": [
      "es2022",
      "dom"
    ],
    "module": "es2022",
    "moduleResolution": "bundler",
    "strict": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "importHelpers": true,
    "paths": {
      "@org/shared/util-error": [
        "libs/shared/util-error/src/index.ts"
      ],
      "@org/shared/util-rbac": [
        "libs/shared/util-rbac/src/index.ts"
      ],
      "@org/shared/util-auth": [
        "libs/shared/util-auth/src/index.ts"
      ],
      "@org/shared/util-org-context": [
        "libs/shared/util-org-context/src/index.ts"
      ],
      "@org/shared/util-types": [
        "libs/shared/util-types/src/index.ts"
      ],
      "@org/activity-log/data-access": [
        "libs/activity-log/data-access/src/index.ts"
      ],
      "@org/auth/data-access": [
        "libs/auth/data-access/src/index.ts"
      ],
      "@org/billing/data-access": [
        "libs/billing/data-access/src/index.ts"
      ],
      "@org/entitlements/data-access": [
        "libs/entitlements/data-access/src/index.ts"
      ],
      "@org/memberships/data-access": [
        "libs/memberships/data-access/src/index.ts"
      ],
      "@org/notifications/data-access": [
        "libs/notifications/data-access/src/index.ts"
      ],
      "@org/organizations/data-access": [
        "libs/organizations/data-access/src/index.ts"
      ],
      "@org/storage/data-access": [
        "libs/storage/data-access/src/index.ts"
      ],
      "@org/tasks/data-access": [
        "libs/tasks/data-access/src/index.ts"
      ],
      "auth/Routes": [
        "apps/auth/src/app/remote-entry/entry.routes.ts"
      ],
      "platform/Routes": [
        "apps/platform/src/app/remote-entry/entry.routes.ts"
      ],
      "admin/Routes": [
        "apps/admin/src/app/remote-entry/entry.routes.ts"
      ]
    }
  }
}