{
  "compilerOptions": {
    "baseUrl": ".",
    "target": "es2022",
    "lib": [
      "es2022",
      "dom"
    ],
    "module": "es2022",
    "moduleResolution": "bundler",
    "strict": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "importHelpers": true,
    "paths": {
      "auth/Routes": [
        "apps/auth/src/app/remote-entry/entry.routes.ts"
      ],
      "platform/Routes": [
        "apps/platform/src/app/remote-entry/entry.routes.ts"
      ],
      "admin/Routes": [
        "apps/admin/src/app/remote-entry/entry.routes.ts"
      ]
    }
  }
}