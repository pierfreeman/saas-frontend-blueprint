{
  "name": "billing-feature",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/billing/feature/src",
  "prefix": "lib",
  "projectType": "library",
  "tags": ["type:feature", "scope:billing"],
  "targets": {
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx vitest run --config libs/billing/feature/vitest.config.ts"
      },
      "configurations": {
        "coverage": {
          "command": "npx vitest run --config libs/billing/feature/vitest.config.ts --coverage"
        }
      }
    }
  }
}
